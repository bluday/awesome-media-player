<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="AwesomeMediaPlayer.UI.Controls.MenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:communityToolkit="using:CommunityToolkit.WinUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">
    <MenuBar Background="{StaticResource SubtleFillColorTertiaryBrush}">
        <MenuBarItem Title="Media">
            <!-- Open file (Ctrl+O) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe8e5;}"
                            Text="Open File...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open multiple files (Ctrl+Shift+O) -->
            <MenuFlyoutItem Text="Open Multiple Files...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O"
                                         Modifiers="Control,Shift"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open folder (Ctrl+F) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xf12b;}"
                            Text="Open Folder...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open disc (Ctrl+D) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe958;}"
                            Text="Open Disc...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="D"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open network stream (Ctrl+N) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe968;}"
                            Text="Open Network Stream...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open capture device (Ctrl+C) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xf211;}"
                            Text="Open Capture Device...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open location from clipboard (Ctrl+V) -->
            <MenuFlyoutItem Text="Open Location from clipboard">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="V"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Open recent media -->
            <MenuFlyoutSubItem Icon="{communityToolkit:FontIcon Glyph=&#xe823;}"
                               Text="Open Recent Media">
                <MenuFlyoutItem Text="file_0.mp3"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Save playlist to file (Ctrl+Y) -->
            <MenuFlyoutItem Text="Save Playlist to File...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Y"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Convert / save (Ctrl+R) -->
            <MenuFlyoutItem Text="Convert / Save...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Stream (Ctrl+S) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe93e;}"
                            Text="Stream...">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator/>

            <!-- Quit at the end of playlist -->
            <MenuFlyoutItem Text="Quit at the end of playlist"/>

            <!-- Quit (Ctrl+Q) -->
            <MenuFlyoutItem Command="{x:Bind QuitCommand}"
                            Icon="{communityToolkit:FontIcon Glyph=&#xe944;}"
                            Text="Quit">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Q"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>

        <MenuBarItem Title="Playback">
            <!-- Title -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Title">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Chapter -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Chapter">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Program -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Program">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Custom bookmarks -->
            <MenuFlyoutSubItem Text="Custom Bookmarks">
                <!-- Manage bookmarks (Ctrl+B) -->
                <MenuFlyoutItem Text="Manage">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B"
                                             Modifiers="Control"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Renderer -->
            <MenuFlyoutSubItem Text="Renderer">
                <MenuFlyoutItem IsEnabled="False"
                                Text="Scanning..."/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Speed -->
            <MenuFlyoutSubItem Text="Speed">
                <MenuFlyoutItem Text="Faster"/>
                <MenuFlyoutItem Text="Faster (fine)"/>
                <MenuFlyoutItem Text="Normal Speed"/>
                <MenuFlyoutItem Text="Slower (fine)"/>
                <MenuFlyoutItem Text="Slower"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Jump forward -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xed3d;}"
                            Text="Jump Forward"/>

            <!-- Jump backward -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xed3c;}"
                            Text="Jump Backward"/>

            <!-- Jump to specific time (Ctrl+T) -->
            <MenuFlyoutItem Text="Jump to Specific Time">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="T"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator/>

            <!-- Play (Space) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xf5b0;}"
                            Text="Play">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Space"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Stop (Ctrl+S) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xee95;}"
                            Text="Stop">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Previous (Ctrl+Left) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xf8ac;}"
                            Text="Previous">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Left"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Next (Ctrl+Right) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xf8ad;}"
                            Text="Next">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Right"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Record (Ctrl+R) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Foreground=Red,
                                                             Glyph=&#xe7c8;}"
                            Text="Record">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="R"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>

        <MenuBarItem Title="Audio">
            <!-- Audio track -->
            <MenuFlyoutSubItem Text="Audio Track">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Audio device -->
            <MenuFlyoutSubItem Text="Audio Device">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Stereo mode -->
            <MenuFlyoutSubItem Text="Stereo Mode">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Visualizations -->
            <MenuFlyoutSubItem Text="Visualizations">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Increase volume -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe995;}"
                            Text="Increase Volume"/>

            <!-- Decrease volume -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe993;}"
                            Text="Decrease Volume"/>

            <!-- Mute -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe74f;}"
                            Text="Mute"/>
        </MenuBarItem>

        <MenuBarItem Title="Video">
            <!-- Video track -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Video Track">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Fullscreen -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe740;}"
                            Text="Fullscreen"/>

            <!-- Always fit window -->
            <MenuFlyoutItem IsEnabled="False"
                            Text="Always Fit Window"/>

            <!-- Set as wallpaper -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe7b5;}"
                            Text="Set as Wallpaper"/>

            <MenuFlyoutSeparator/>

            <!-- Zoom -->
            <MenuFlyoutSubItem Icon="{communityToolkit:FontIcon Glyph=&#xe71e;}"
                               IsEnabled="False"
                               Text="Zoom">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Aspect ratio -->
            <MenuFlyoutSubItem Icon="{communityToolkit:FontIcon Glyph=&#xe799;}"
                               IsEnabled="False"
                               Text="Aspect Ratio">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Crop -->
            <MenuFlyoutSubItem Icon="{communityToolkit:FontIcon Glyph=&#xe7a8;}"
                               IsEnabled="False"
                               Text="Crop">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Deinterlace -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Deinterlace">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <!-- Deinterlace mode -->
            <MenuFlyoutSubItem IsEnabled="False"
                               Text="Deinterlace mode">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Take snapshot -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe722;}"
                            IsEnabled="False"
                            Text="Take Snapshot"/>
        </MenuBarItem>

        <MenuBarItem Title="Subtitle">
            <!-- Add subtitle file -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe710;}"
                            Text="Add Subtitle File..."/>

            <!-- Sub track -->
            <MenuFlyoutSubItem Icon="{communityToolkit:FontIcon Glyph=&#xed1e;}"
                               IsEnabled="False"
                               Text="Sub Track">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>
        </MenuBarItem>

        <MenuBarItem Title="Tools">
            <!-- Effects and filters (Ctrl+E) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe9e9;}"
                            Text="Effects and Filters">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="E"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Track synchronization -->
            <MenuFlyoutItem Text="Track Synchronization"/>

            <!-- Media information (Ctrl+I) -->
            <MenuFlyoutItem Text="Media Information">
                <MenuFlyoutItem.Icon>
                    <FontIcon Foreground="{ThemeResource SystemAccentColor}"
                              Glyph="&#xe946;"/>
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="I"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Codec information (Ctrl+J) -->
            <MenuFlyoutItem Text="Codec Information">
                <MenuFlyoutItem.Icon>
                    <FontIcon Foreground="{ThemeResource SystemAccentColor}"
                              Glyph="&#xe946;"/>
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="J"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- VLM configuration (Ctrl+Shift+W) -->
            <MenuFlyoutItem Text="VLM Configuration">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="W"
                                         Modifiers="Control,Shift"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Process guide -->
            <MenuFlyoutItem Text="Program Guide"/>

            <!-- Messages (Ctrl+M) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe756;}"
                            Text="Messages">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Plugins and extensions -->
            <MenuFlyoutItem Text="Plugins and Extensions"/>

            <MenuFlyoutSeparator/>

            <!-- Customize interface -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe713;}"
                            Text="Customize Interface..."/>

            <!-- Preferences (Ctrl+P) -->
            <MenuFlyoutItem Command="{x:Bind OpenPreferencesWindowCommand}"
                            Icon="{communityToolkit:FontIcon Glyph=&#xe713;}"
                            Text="Preferences">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="P"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>

        <MenuBarItem Title="View">
            <!-- Playlist (Ctrl+L) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe90b;}"
                            Text="Playlist">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="L"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Docked playlist -->
            <MenuFlyoutItem Text="Docked Playlist"/>

            <!-- Playlist view mode -->
            <MenuFlyoutSubItem Text="Playlist View Mode">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- Always on top -->
            <MenuFlyoutItem Text="Always on top"/>

            <MenuFlyoutSeparator/>

            <!-- Minimal interface (Ctrl+H) -->
            <MenuFlyoutItem Text="Minimal Interface">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="H"
                                         Modifiers="Control"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Fullscreen interface (F11) -->
            <MenuFlyoutItem Icon="{communityToolkit:FontIcon Glyph=&#xe740;}"
                            Text="Fullscreen Interface">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F11"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Advanced controls -->
            <MenuFlyoutItem Text="Advanced Controls"/>

            <!-- Status bar -->
            <MenuFlyoutItem Text="Status Bar"/>

            <MenuFlyoutSeparator/>

            <!-- Add interface -->
            <MenuFlyoutSubItem Text="Add Interface">
                <MenuFlyoutItem Text="Content"/>
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator/>

            <!-- VLsub -->
            <MenuFlyoutItem Text="VLsub"/>
        </MenuBarItem>

        <MenuBarItem Title="Help">
            <!-- Help (F1) -->
            <MenuFlyoutItem Command="{x:Bind OpenHelpWindowCommand}"
                            Text="Help">
                <MenuFlyoutItem.Icon>
                    <FontIcon Foreground="{ThemeResource SystemAccentColor}"
                              Glyph="&#xe897;"/>
                </MenuFlyoutItem.Icon>
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F1"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>

            <!-- Check for updates -->
            <MenuFlyoutItem Text="Check for Updates..."/>

            <MenuFlyoutSeparator/>

            <!-- About (Shift+F1) -->
            <MenuFlyoutItem Command="{x:Bind OpenAboutWindowCommand}"
                            Text="About">
                <MenuFlyoutItem.Icon>
                    <FontIcon Foreground="{ThemeResource SystemAccentColor}"
                              Glyph="&#xe946;"/>
                </MenuFlyoutItem.Icon>

                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F1"
                                         Modifiers="Shift"/>
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
        </MenuBarItem>
    </MenuBar>
</UserControl>