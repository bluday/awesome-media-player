<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="AwesomeMediaPlayer.UI.Controls.MediaControlBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:communityToolkit="using:CommunityToolkit.WinUI"
             xmlns:controls="using:AwesomeMediaPlayer.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             MaxHeight="80"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">
    <Grid Padding="4"
          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
          BorderThickness="{x:Bind BorderThickness}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <Style BasedOn="{StaticResource DefaultButtonStyle}"
                   TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="28"/>
            </Style>

            <Style TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Spacing" Value="2"/>
            </Style>

            <Style TargetType="Viewbox">
                <Setter Property="Height" Value="16"/>
                <Setter Property="Width" Value="16"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="2"
              Padding="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Text="--:--"/>

            <Slider Grid.Column="1"
                    Margin="16,-4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IntermediateValue="0"
                    Value="0"/>

            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="--:--"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="16">
                <!-- f8ae (Pause) -->
                <Button Width="32"
                        Height="32"
                        Content="{communityToolkit:FontIcon FontSize=20,
                                                            Glyph=&#xf5b0;}"/>

                <StackPanel>
                    <!-- eb9e (Rewind) -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xf8ac;}"/>

                    <!-- e71a (Stop) -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xe73b;}"/>

                    <!-- eb9d (FastForward) -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xf8ad;}"/>
                </StackPanel>

                <StackPanel>
                    <!-- e73f (Back to windowed mode) -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15,
                                                                Glyph=&#xe740;}"
                            IsEnabled="False"/>

                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xe9e9;}"/>
                </StackPanel>

                <StackPanel>
                    <!--
                        * e8ee (All)
                        * f5e7 (Off)
                    -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xe8ed;}"/>

                    <!-- SystemAccentColor -->
                    <Button Content="{communityToolkit:FontIcon FontSize=15, Glyph=&#xe8b1;}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="8,0"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <!--
                    * e992 (Volume0)
                    * e993 (Volume1)
                    * e994 (Volume2)
                    * e995 (Volume3)
                    * e74f (Mute)
                -->
                <Button Background="Transparent"
                        BorderBrush="Transparent"
                        Content="{communityToolkit:FontIcon FontSize=15,
                                                            Glyph=&#xe767;}"/>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="100%"/>

                <Slider Width="128"
                        Value="100"/>
            </StackPanel>
        </Grid>

        <controls:WindowCornerDragHandle Grid.Row="2"
                                         Grid.Column="1"
                                         Visibility="{x:Bind CornerDragHandleVisibility}"/>
    </Grid>
</UserControl>