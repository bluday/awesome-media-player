<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="AwesomeMediaPlayer.UI.Controls.WindowCornerDragHandle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             mc:Ignorable="d">
    <Path Width="10"
          Height="10"
          Fill="{ThemeResource ControlElevationBorderBrush}">
        <Path.Data>
            <GeometryGroup>
                <RectangleGeometry Rect="0,8,2,2"/>

                <RectangleGeometry Rect="4,4,2,2"/>
                <RectangleGeometry Rect="4,8,2,2"/>

                <RectangleGeometry Rect="8,0,2,2"/>
                <RectangleGeometry Rect="8,4,2,2"/>
                <RectangleGeometry Rect="8,8,2,2"/>
            </GeometryGroup>
        </Path.Data>
    </Path>
</UserControl>