<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="AwesomeMediaPlayer.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:communityToolkit="using:CommunityToolkit.WinUI"
             xmlns:communityToolkitControls="using:CommunityToolkit.WinUI.Controls"
             xmlns:communityToolkitUiControls="using:CommunityToolkit.WinUI.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="using:AwesomeMediaPlayer.UI.ViewModels"
             xmlns:xamlInteractivity="using:Microsoft.Xaml.Interactivity"
             d:DataContext="{d:DesignInstance Type=viewModels:AboutViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Width="200"
                  Height="200">
                <Image Width="400"
                       Height="400"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="/Assets/LargeTile.png"
                       Stretch="Uniform"/>
            </Grid>

            <Grid Grid.Column="1"
                  Padding="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Margin="0"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="Awesome Media Player"/>

                <TextBlock Grid.Row="1"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="1.0a Vetinari"/>

                <ScrollViewer Grid.Row="3">
                    <communityToolkitUiControls:MarkdownTextBlock Background="Transparent"
                                                                  FontSize="12"
                                                                  Header5FontWeight="Bold"
                                                                  Header5Margin="0,16,0,8"
                                                                  ParagraphMargin="0,0,0,16"
                                                                  Text="{Binding Text}"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Height="50"
              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.Resources>
                <Style BasedOn="{StaticResource DefaultHyperlinkButtonStyle}"
                       TargetType="HyperlinkButton">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

                <Style TargetType="TextBlock">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Style>
            </Grid.Resources>

            <HyperlinkButton Grid.Column="0"
                             Content="Authors"/>
            <HyperlinkButton Grid.Column="1"
                             Content="License"/>
            <HyperlinkButton Grid.Column="2"
                             Content="Credits"/>
        </Grid>
    </Grid>
</UserControl>
